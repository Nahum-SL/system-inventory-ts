{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2023",
    "types": ["node"],

    "rootDir": ".",
    "noEmit": true,


    "outDir": "dist",

    "sourceMap": true,
    "declaration": false,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "tests", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}